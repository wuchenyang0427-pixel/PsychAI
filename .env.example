# ============================================================
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# 【必填】DeepSeek API 密钥，申请地址 https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-在此填入你的密钥

# 【可选】大模型接口地址与模型名，默认走 DeepSeek 官方
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
